{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.codex/**": true,
    "**/.cursor/**": true,
    "**/.project/**": true,
    "**/.scratch/**": true,
    "**/.superdesign/**": true,
    "**/artifacts/**": true,
    "**/build-code-agent-main/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/.vite/**": true,
    "**/node_modules/**": true,
    "**/out/**": true,
    "**/output/**": true,
    "**/playwright-report/**": true,
    "**/src/renderer/.vite/**": true,
    "**/test-results/**": true
  },
  "search.exclude": {
    "**/.cursor/**": true,
    "**/.project/**": true,
    "**/.scratch/**": true,
    "**/.superdesign/**": true,
    "**/artifacts/**": true,
    "**/build-code-agent-main/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/.vite/**": true,
    "**/node_modules/**": true,
    "**/out/**": true,
    "**/output/**": true,
    "**/playwright-report/**": true,
    "**/src/renderer/.vite/**": true,
    "**/test-results/**": true
  },
  "files.exclude": {
    "**/.cursor/**": true,
    "**/.project/**": true,
    "**/.scratch/**": true,
    "**/.superdesign/**": true,
    "**/artifacts/**": true,
    "**/build-code-agent-main/**": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/.vite/**": true,
    "**/node_modules/**": true,
    "**/out/**": true,
    "**/output/**": true,
    "**/playwright-report/**": true,
    "**/src/renderer/.vite/**": true,
    "**/test-results/**": true
  },
  "files.maxMemoryForLargeFilesMB": 256,
  "git.autoRepositoryDetection": false,
  "npm.autoDetect": "off",
  "grunt.autoDetect": "off",
  "gulp.autoDetect": "off",
  "jake.autoDetect": "off",
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.maxTsServerMemory": 2048,
  "python.analysis.indexing": false,
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  }
}
